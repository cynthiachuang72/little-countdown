{
  "expo": {
    "name": "Little Countdown",
    "slug": "little-countdown",
    "scheme": "littlecountdown",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cynthiachuang.littlecountdown",
      "appleTeamId": "YOUR_TEAM_ID",
      "supportsTablet": false,
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.cynthiachuang.littlecountdown"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cynthiachuang.littlecountdown",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EDF0F6"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9bbd6f68-c9c6-4d38-a19e-63ee637a21ac"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#EDF0F6",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#161A25"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C9738B"
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LittleCountdown",
              "label": "Little Countdown",
              "description": "Days to baby and to maternity leave, with today's little joy",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9bbd6f68-c9c6-4d38-a19e-63ee637a21ac"
      }
    }
  }
}
